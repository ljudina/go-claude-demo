package templates

import (
	"claude-test/internal/domain"
	"fmt"
)

type UserWithRoles struct {
	User  *domain.User
	Roles []*domain.Role
}

templ UsersPage(users []UserWithRoles, auth *AuthInfo) {
	@Layout("Users", auth) {
		<div class="page-header d-print-none">
			<div class="row align-items-center">
				<div class="col-auto">
					<h2 class="page-title">Users</h2>
				</div>
				<div class="col-auto ms-auto">
					<a href="/web/users/new" class="btn btn-primary">
						<svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
							<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
							<line x1="12" y1="5" x2="12" y2="19"></line>
							<line x1="5" y1="12" x2="19" y2="12"></line>
						</svg>
						Add User
					</a>
				</div>
			</div>
		</div>
		<div class="card mt-3">
			<div class="table-responsive">
				<table class="table table-vcenter card-table">
					<thead>
						<tr>
							<th>ID</th>
							<th>Email</th>
							<th>Name</th>
							<th>Roles</th>
							<th class="w-1">Actions</th>
						</tr>
					</thead>
					<tbody id="users-table">
						for _, u := range users {
							@UserRow(u)
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ UserRow(u UserWithRoles) {
	<tr id={ fmt.Sprintf("user-%d", u.User.ID) }>
		<td>{ fmt.Sprintf("%d", u.User.ID) }</td>
		<td>
			<a href={ templ.SafeURL(fmt.Sprintf("/web/users/%d/edit", u.User.ID)) } class="text-reset">{ u.User.Email }</a>
		</td>
		<td>{ u.User.Name }</td>
		<td>
			for _, role := range u.Roles {
				<span class="badge bg-azure-lt me-1">{ role.Name }</span>
			}
		</td>
		<td>
			<div class="btn-list flex-nowrap">
				<a href={ templ.SafeURL(fmt.Sprintf("/web/users/%d/edit", u.User.ID)) } class="btn btn-sm">Edit</a>
				<button
					class="btn btn-sm btn-danger"
					hx-delete={ fmt.Sprintf("/web/users/%d", u.User.ID) }
					hx-target={ fmt.Sprintf("#user-%d", u.User.ID) }
					hx-swap="outerHTML"
					hx-confirm="Are you sure you want to delete this user?"
				>
					Delete
				</button>
			</div>
		</td>
	</tr>
}

templ UserForm(user *domain.User, userRoleIDs []int64, allRoles []*domain.Role, isEdit bool, err string, auth *AuthInfo) {
	@Layout(formTitle(isEdit), auth) {
		<div class="page-header d-print-none">
			<div class="row align-items-center">
				<div class="col-auto">
					<h2 class="page-title">{ formTitle(isEdit) }</h2>
				</div>
			</div>
		</div>
		<div class="card mt-3">
			<div class="card-body">
				if err != "" {
					<div class="alert alert-danger" role="alert">{ err }</div>
				}
				<form
					if isEdit {
						hx-put={ fmt.Sprintf("/web/users/%d", user.ID) }
					} else {
						hx-post="/web/users"
					}
					hx-target="body"
					hx-swap="innerHTML"
				>
					<div class="mb-3">
						<label class="form-label required" for="email">Email</label>
						<input type="email" class="form-control" id="email" name="email" value={ user.Email } required/>
					</div>
					<div class="mb-3">
						<label class="form-label required" for="name">Name</label>
						<input type="text" class="form-control" id="name" name="name" value={ user.Name } required/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="roles">Roles</label>
						<select class="form-select" id="roles" name="roles" multiple size="4">
							for _, role := range allRoles {
								<option value={ fmt.Sprintf("%d", role.ID) } selected?={ hasRole(userRoleIDs, role.ID) }>
									{ role.Name }
								</option>
							}
						</select>
						<small class="form-hint">Hold Ctrl/Cmd to select multiple</small>
					</div>
					<div class="mb-0">
						<button type="submit" class="btn btn-primary">
							if isEdit {
								Update
							} else {
								Create
							}
						</button>
						<a href="/web/users" class="btn btn-outline-secondary ms-2">Cancel</a>
					</div>
				</form>
			</div>
		</div>
	}
}

func formTitle(isEdit bool) string {
	if isEdit {
		return "Edit User"
	}
	return "New User"
}

func hasRole(roleIDs []int64, roleID int64) bool {
	for _, id := range roleIDs {
		if id == roleID {
			return true
		}
	}
	return false
}
